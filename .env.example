HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified

# Checkout
STRIPE_KEY=sk_test_tobemodified
CLIENT_URL=http://localhost:3000
# Costo de envío que realmente se cobra. El frontend solo previsualiza con
# NEXT_PUBLIC_DELIVERY_COST: las dos se mueven juntas, pero manda ésta.
DELIVERY_COST_MXN=200

# Firma del webhook de Stripe. En producción sale del Dashboard
# (Developers > Webhooks); en local lo imprime `stripe listen`.
# Son secretos DISTINTOS: no intercambiarlos.
STRIPE_WEBHOOK_SECRET=whsec_tobemodified

# Aviso por correo de casos nuevos (src/api/case/utils/notificar-caso.ts).
# Va por el SMTP de Resend; sin SMTP_HOST no se envía nada.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_PASSWORD=re_tobemodified
EMAIL_FROM=avisos@tudominio.com
CASE_NOTIFY_EMAILS=coordinacion@tudominio.com
