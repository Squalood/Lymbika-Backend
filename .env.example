# Firma del webhook de Stripe. En producción sale del Dashboard
# (Developers > Webhooks); en local lo imprime `stripe listen`.
# Son secretos DISTINTOS: no intercambiarlos.
STRIPE_WEBHOOK_SECRET=whsec_tobemodified
