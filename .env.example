HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified

# Checkout
STRIPE_KEY=sk_test_tobemodified
CLIENT_URL=http://localhost:3000
# Costo de envío que realmente se cobra. El frontend solo previsualiza con
# NEXT_PUBLIC_DELIVERY_COST: las dos se mueven juntas, pero manda ésta.
DELIVERY_COST_MXN=200

# Firma del webhook de Stripe. En producción sale del Dashboard
# (Developers > Webhooks); en local lo imprime `stripe listen`.
# Son secretos DISTINTOS: no intercambiarlos.
STRIPE_WEBHOOK_SECRET=whsec_tobemodified

# Aviso por correo de casos nuevos (src/api/case/utils/notificar-caso.ts).
# Va por el SMTP de Resend; sin SMTP_HOST no se envía nada.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_PASSWORD=re_tobemodified
EMAIL_FROM=avisos@tudominio.com
CASE_NOTIFY_EMAILS=coordinacion@tudominio.com

# Pre-llenado de fichas con IA (scripts/prellenar-fichas.js). Solo en la PC
# local: el backend en Render no las usa.
ANTHROPIC_API_KEY=sk-ant-tobemodified
# Backend contra el que lee/escribe el script (default: producción).
# LYMBIKA_API_URL=http://localhost:1337
# Token Custom (admin → Settings → API Tokens) con find/create/update de
# principio-activo e indicacion y find de service. Solo para aplicar-catalogos.
LYMBIKA_API_TOKEN=tobemodified
