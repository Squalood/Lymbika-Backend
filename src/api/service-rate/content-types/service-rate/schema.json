{
  "kind": "collectionType",
  "collectionName": "service_rates",
  "info": {
    "singularName": "service-rate",
    "pluralName": "service-rates",
    "displayName": "Service Rate"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "medical_service": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::medical-service.medical-service",
      "inversedBy": "service_rates"
    },
    "doctor": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::doctor.doctor",
      "inversedBy": "service_rates"
    },
    "clinic": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::clinic.clinic",
      "inversedBy": "service_rates"
    },
    "price": {
      "type": "decimal",
      "required": true
    },
    "duration_min": {
      "type": "integer"
    },
    "notes": {
      "type": "text"
    },
    "package_label": {
      "type": "string"
    },
    "package_items": {
      "type": "json"
    },
    "package_note": {
      "type": "text"
    },
    "items": {
      "type": "component",
      "component": "plus.plus",
      "repeatable": true
    },
    "comercialidad": {
      "type": "integer"
    },
    "destacado": {
      "type": "boolean",
      "default": false
    },
    "badgePrestigio": {
      "type": "string"
    },
    "requiereCirugia": {
      "type": "boolean"
    },
    "enCatalogo": {
      "type": "boolean",
      "default": false
    },
    "tituloTarjeta": {
      "type": "string"
    },
    "descripcion": {
      "type": "text"
    },
    "periodo": {
      "type": "string"
    },
    "detallePrecio": {
      "type": "string"
    },
    "textoSinPrecio": {
      "type": "string"
    },
    "noIncluye": {
      "type": "component",
      "component": "plus.plus",
      "repeatable": true
    },
    "estiloTarjeta": {
      "type": "enumeration",
      "enum": [
        "claro",
        "tinte",
        "oscuro"
      ],
      "default": "claro"
    },
    "icono": {
      "type": "enumeration",
      "default": "Stethoscope",
      "enum": [
        "Stethoscope",
        "UserRound",
        "Droplet",
        "Activity",
        "Heart",
        "HeartPulse",
        "HeartHandshake",
        "Route",
        "Syringe",
        "Microscope",
        "ClipboardCheck",
        "Pill",
        "Ambulance",
        "Hospital",
        "Scissors",
        "Bandage",
        "Baby",
        "Brain",
        "Bone",
        "ScanHeart",
        "Venus",
        "Ribbon",
        "Sparkles"
      ]
    }
  }
}
