{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "productName": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "productName"
    },
    "images": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "price": {
      "type": "decimal"
    },
    "tipo": {
      "type": "enumeration",
      "enum": [
        "Pildora",
        "Antigripal",
        "Dolor y Fiebre",
        "Gripe y Tos",
        "Alergias y Respiratorios",
        "Salud Digestiva",
        "Vitaminas y Suplementos",
        "Salud de la Piel",
        "Cuidado Femenino",
        "Salud Sexual y Reproductiva",
        " Salud Mental y Sueño",
        " Diabetes y Control de Glucosa",
        " Hipertensión y Salud del Corazón",
        " Enfermedades Crónicas",
        " Medicamentos Especializados",
        " Antibióticos y Antivirales",
        " Cuidado Infantil y Pediátrico"
      ]
    },
    "isFeatured": {
      "type": "boolean"
    },
    "category": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::category.category"
    },
    "priceMember": {
      "type": "decimal"
    },
    "descriptionPro": {
      "type": "blocks"
    },
    "sal": {
      "type": "text"
    },
    "clinics": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::clinic.clinic",
      "inversedBy": "products"
    },
    "videos": {
      "type": "component",
      "component": "video-id.youtube-video",
      "repeatable": true
    },
    "barCode": {
      "type": "string"
    },
    "conReceta": {
      "type": "boolean",
      "default": false
    },
    "sku": {
      "type": "string"
    },
    "stock_central": {
      "type": "integer",
      "default": 0
    },
    "pharmacy_stocks": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::pharmacy-stock.pharmacy-stock",
      "mappedBy": "product"
    },
    "priceInpatient": {
      "type": "decimal"
    },
    "laboratorio": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::laboratorio.laboratorio",
      "inversedBy": "products"
    },
    "drug_type": {
      "type": "enumeration",
      "enum": [
        "generic",
        "branded"
      ]
    },
    "reviews": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::review.review",
      "mappedBy": "product"
    },
    "inventory_lots": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::inventory-lot.inventory-lot",
      "mappedBy": "product"
    },
    "impuesto": {
      "type": "enumeration",
      "default": "iva0",
      "enum": [
        "iva0",
        "iva8",
        "iva16"
      ]
    },
    "tipoProducto": {
      "type": "enumeration",
      "enum": [
        "medicamento",
        "suplemento",
        "dermocosmetico",
        "dispositivoMedico",
        "higienePersonal",
        "otro"
      ]
    },
    "composicion": {
      "type": "component",
      "component": "producto.composicion",
      "repeatable": true
    },
    "formaFarmaceutica": {
      "type": "enumeration",
      "enum": [
        "tableta",
        "tabletaMasticable",
        "tabletaEfervescente",
        "tabletaSublingual",
        "capsula",
        "jarabe",
        "suspension",
        "solucionOral",
        "gotasOrales",
        "polvo",
        "crema",
        "gel",
        "unguento",
        "locion",
        "solucionTopica",
        "spray",
        "inhalador",
        "solucionNebulizar",
        "solucionNasal",
        "gotasOftalmicas",
        "gotasOticas",
        "ovulo",
        "supositorio",
        "inyectable",
        "parche",
        "otro"
      ]
    },
    "viaAdministracion": {
      "type": "enumeration",
      "enum": [
        "oral",
        "sublingual",
        "topica",
        "oftalmica",
        "otica",
        "nasal",
        "inhalada",
        "vaginal",
        "rectal",
        "intramuscular",
        "intravenosa",
        "subcutanea",
        "otra"
      ]
    },
    "contenidoCantidad": {
      "type": "decimal"
    },
    "contenidoUnidad": {
      "type": "enumeration",
      "enum": [
        "tabletas",
        "capsulas",
        "ml",
        "g",
        "sobres",
        "piezas",
        "ampolletas",
        "ovulos",
        "supositorios",
        "parches",
        "dosis"
      ]
    },
    "fraccion": {
      "type": "enumeration",
      "enum": [
        "I",
        "II",
        "III",
        "IV",
        "V",
        "VI"
      ]
    },
    "edadMinimaMeses": {
      "type": "integer",
      "min": 0
    },
    "indicaciones": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::indicacion.indicacion",
      "inversedBy": "products"
    },
    "posologia": {
      "type": "text"
    },
    "advertenciasAdicionales": {
      "type": "text"
    },
    "registroSanitario": {
      "type": "string"
    },
    "prospecto": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "files"
      ]
    },
    "requiereRefrigeracion": {
      "type": "boolean"
    },
    "sinAzucar": {
      "type": "boolean"
    },
    "fuenteInfo": {
      "type": "enumeration",
      "enum": [
        "empaque",
        "ipp",
        "plm",
        "ia",
        "otra"
      ]
    },
    "estadoFicha": {
      "type": "enumeration",
      "default": "pendiente",
      "enum": [
        "pendiente",
        "revisada"
      ]
    },
    "revisadoPor": {
      "type": "string"
    },
    "fechaRevision": {
      "type": "date"
    }
  }
}
